APP_NAME="Regime Aware Portfolio Risk Analytics"
APP_VERSION=0.1.0
ENVIRONMENT=development
API_PREFIX=/api/v1
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./data/regime.db
RUN_MIGRATIONS_ON_STARTUP=false
CREATE_DB_ON_STARTUP=false

# Generate a long random value before deploying.
AUTH_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_COOKIE_NAME=rapra_access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FII_DII_CSV_PATH=data/external/fii_dii.csv
MARKET_DATA_PROVIDER=yahoo
MARKET_DATA_CACHE_TTL_SECONDS=900
MARKET_DATA_PROVIDER_RETRIES=3
MARKET_DATA_PROVIDER_RETRY_BACKOFF_SECONDS=0.25
MARKET_DATA_REFRESH_ENABLED=false
MARKET_DATA_REFRESH_INTERVAL_SECONDS=900
MARKET_DATA_REFRESH_SYMBOLS=
REGIME_MODEL_DIR=models
