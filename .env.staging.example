# Copy to .env.staging and replace every example hostname and secret.
# Keep this file out of the frontend: all values are consumed by Docker Compose or the API.
APP_NAME=Latent
APP_VERSION=0.1.0
ENVIRONMENT=staging
API_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_JSON=true

# Use a dedicated managed PostgreSQL database. URL-encode special password characters.
DATABASE_URL=postgresql+psycopg://user:password@staging-db-pooler.example.com:5432/latent_staging?sslmode=require&channel_binding=require
MIGRATION_DATABASE_URL=postgresql+psycopg://user:password@staging-db.example.com:5432/latent_staging?sslmode=require&channel_binding=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_SSL_MODE=require
RUN_MIGRATIONS_ON_STARTUP=false
CREATE_DB_ON_STARTUP=false

# Generate with: openssl rand -hex 32
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=1440
GUEST_SESSION_EXPIRE_MINUTES=720
GUEST_DATA_RETENTION_HOURS=24
GUEST_CLEANUP_INTERVAL_SECONDS=3600
AUTH_COOKIE_NAME=latent_staging_access_token
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax

# Replace these with the real staging origins. Keep frontend and API on the same parent domain.
CORS_ORIGINS=https://app.staging.example.com
TRUSTED_HOSTS=api.staging.example.com,localhost,127.0.0.1
FORWARDED_ALLOW_IPS=127.0.0.1
API_DOCS_ENABLED=false

CSV_UPLOAD_MAX_BYTES=5242880
REQUEST_BODY_MAX_BYTES=6291456
CSV_UPLOAD_MAX_ROWS=10000
CSV_UPLOAD_MAX_COLUMNS=30
CSV_UPLOAD_MAX_FIELD_CHARACTERS=2000
CSV_UPLOAD_MAX_CELLS=200000
CSV_RESOLUTION_MAX_CHANGES=2000
CSV_UPLOAD_RATE_LIMIT=20
CSV_UPLOAD_IP_RATE_LIMIT=50
CSV_UPLOAD_RATE_LIMIT_WINDOW_SECONDS=3600
PORTFOLIO_MAX_PER_USER=50
PORTFOLIO_MAX_PER_GUEST=5
PORTFOLIO_MAX_TRADES=10000
PORTFOLIO_WORKLOAD_RATE_LIMIT=240
PORTFOLIO_GUEST_WORKLOAD_RATE_LIMIT=60
PORTFOLIO_IP_WORKLOAD_RATE_LIMIT=500
PORTFOLIO_WORKLOAD_RATE_LIMIT_WINDOW_SECONDS=3600

AUTH_LOGIN_RATE_LIMIT=10
AUTH_SIGNUP_RATE_LIMIT=5
GUEST_RATE_LIMIT=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
SIGNUP_RATE_LIMIT_WINDOW_SECONDS=3600
AI_RATE_LIMIT=30
AI_GUEST_RATE_LIMIT=10
AI_IP_RATE_LIMIT=100
AI_RATE_LIMIT_WINDOW_SECONDS=3600
ANALYTICS_RATE_LIMIT=120
ANALYTICS_GUEST_RATE_LIMIT=30
ANALYTICS_IP_RATE_LIMIT=300
ANALYTICS_RATE_LIMIT_WINDOW_SECONDS=3600

MARKET_DATA_PROVIDER=yahoo
MARKET_DATA_CACHE_TTL_SECONDS=900
INSTRUMENT_METADATA_TTL_DAYS=30
MARKET_DATA_PROVIDER_RETRIES=3
MARKET_DATA_PROVIDER_RETRY_BACKOFF_SECONDS=0.25
MARKET_DATA_MAX_TICKERS_PER_REQUEST=20
MARKET_DATA_MAX_HISTORY_DAYS=3650
MARKET_PUBLIC_RATE_LIMIT=30
MARKET_USER_RATE_LIMIT=240
MARKET_IP_RATE_LIMIT=500
MARKET_RATE_LIMIT_WINDOW_SECONDS=3600
MARKET_DATA_REFRESH_ENABLED=false
MARKET_DATA_REFRESH_INTERVAL_SECONDS=900
MARKET_DATA_REFRESH_SYMBOLS=
FII_DII_CSV_PATH=data/external/fii_dii.csv

REGIME_MODEL_DIR=models
REGIME_RUNTIME_FIT_ENABLED=false
REGIME_MAX_OBSERVATIONS=1500
REGIME_VALIDATION_REPORT_PATH=models/regime_validation_report.json
# Keep false until the staging validation report has been reviewed and approved.
REQUIRE_VALIDATED_REGIME_MODEL=false
INTELLIGENCE_CACHE_TTL_SECONDS=60

# Optional managed AI. Leave blank to use Latent's grounded local fallback in staging.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_FALLBACK_MODELS=z-ai/glm-5.3-flash,z-ai/glm-5.3
AI_MAX_OUTPUT_TOKENS=700
AI_HISTORY_MESSAGES=6
AI_RETRIEVAL_TOP_K=4
AI_RETRIEVAL_CHARACTER_BUDGET=6000

GZIP_MINIMUM_SIZE_BYTES=1000
SLOW_REQUEST_THRESHOLD_MS=1500
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# Public frontend build configuration and local container bindings.
NEXT_PUBLIC_API_BASE_URL=https://api.staging.example.com/api/v1
NEXT_PUBLIC_SITE_URL=https://app.staging.example.com
NEXT_PUBLIC_API_TIMEOUT_MS=60000
NEXT_PUBLIC_APP_ENV=production
STAGING_API_PORT=8000
STAGING_WEB_PORT=3000
STAGING_READY_URL=http://127.0.0.1:8000/api/v1/ready
