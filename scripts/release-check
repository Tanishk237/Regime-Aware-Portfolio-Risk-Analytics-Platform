#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BACKEND_PYTHON="${LATENT_PYTHON:-${ROOT_DIR}/venv/bin/python}"

cd "${ROOT_DIR}"
"${BACKEND_PYTHON}" -m pip check
"${BACKEND_PYTHON}" -m pip_audit --strict --requirement requirements.txt
"${BACKEND_PYTHON}" -m pytest -q
"${BACKEND_PYTHON}" scripts/check_secrets.py

cd "${ROOT_DIR}/frontend"
npm run smoke
npm run lint
npm run typecheck
npm run build
npm run test:e2e

echo "Release checks passed."
