#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BACKEND_HOST="${BACKEND_HOST:-127.0.0.1}"
BACKEND_PORT="${BACKEND_PORT:-8000}"
FRONTEND_HOST="${FRONTEND_HOST:-localhost}"
FRONTEND_PORT="${FRONTEND_PORT:-3000}"

BACKEND_PID=""
FRONTEND_PID=""

cleanup() {
	echo
	echo "Stopping Latent dev servers..."
	if [[ -n "${BACKEND_PID}" ]] && kill -0 "${BACKEND_PID}" 2>/dev/null; then
		kill "${BACKEND_PID}" 2>/dev/null || true
	fi
	if [[ -n "${FRONTEND_PID}" ]] && kill -0 "${FRONTEND_PID}" 2>/dev/null; then
		kill "${FRONTEND_PID}" 2>/dev/null || true
	fi
	wait 2>/dev/null || true
}

trap cleanup EXIT INT TERM

if [[ ! -x "${ROOT_DIR}/venv/bin/uvicorn" ]]; then
	echo "Backend venv not found. Run: python3 -m venv venv && source venv/bin/activate && pip install -r requirements.txt"
	exit 1
fi

if [[ ! -d "${ROOT_DIR}/frontend/node_modules" ]]; then
	echo "Frontend dependencies not found. Run: cd frontend && npm install"
	exit 1
fi

"${ROOT_DIR}/scripts/bootstrap"

echo "Starting Latent backend:  http://${BACKEND_HOST}:${BACKEND_PORT}"
(
	cd "${ROOT_DIR}"
	"${ROOT_DIR}/venv/bin/uvicorn" src.api.main:app --reload --host "${BACKEND_HOST}" --port "${BACKEND_PORT}"
) &
BACKEND_PID=$!

echo "Starting Latent frontend: http://${FRONTEND_HOST}:${FRONTEND_PORT}"
(
	cd "${ROOT_DIR}/frontend"
	npm run dev -- --hostname "${FRONTEND_HOST}" --port "${FRONTEND_PORT}"
) &
FRONTEND_PID=$!

echo
echo "Latent is starting."
echo "Frontend: http://${FRONTEND_HOST}:${FRONTEND_PORT}/login"
echo "Backend:  http://${BACKEND_HOST}:${BACKEND_PORT}/api/v1/health"
echo
echo "Press Ctrl+C to stop both servers."

wait
