#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BACKEND_HOST="${BACKEND_HOST:-127.0.0.1}"
BACKEND_PORT="${BACKEND_PORT:-8000}"
FRONTEND_HOST="${FRONTEND_HOST:-localhost}"
FRONTEND_PORT="${FRONTEND_PORT:-3000}"
BACKEND_PYTHON="${LATENT_PYTHON:-${ROOT_DIR}/venv/bin/python}"
DEMO_MODE=false
case "${1:-}" in
	--demo) DEMO_MODE=true ;;
	"") ;;
	*) echo "Usage: ./scripts/dev [--demo]"; exit 1 ;;
esac

BACKEND_PID=""
FRONTEND_PID=""

port_in_use() {
	local port="$1"
	if command -v lsof >/dev/null 2>&1; then
		lsof -nP -iTCP:"${port}" -sTCP:LISTEN >/dev/null 2>&1
		return
	fi
	"${BACKEND_PYTHON}" -c 'import socket, sys; sock = socket.socket(); sock.settimeout(0.2); raise SystemExit(0 if sock.connect_ex(("127.0.0.1", int(sys.argv[1]))) == 0 else 1)' "${port}"
}

next_available_port() {
	local port="$1"
	while port_in_use "${port}"; do
		port=$((port + 1))
	done
	echo "${port}"
}

cleanup() {
	echo
	echo "Stopping Latent dev servers..."
	if [[ -n "${BACKEND_PID}" ]] && kill -0 "${BACKEND_PID}" 2>/dev/null; then
		kill "${BACKEND_PID}" 2>/dev/null || true
	fi
	if [[ -n "${FRONTEND_PID}" ]] && kill -0 "${FRONTEND_PID}" 2>/dev/null; then
		kill "${FRONTEND_PID}" 2>/dev/null || true
	fi
	wait 2>/dev/null || true
}

trap cleanup EXIT INT TERM

if [[ ! -x "${BACKEND_PYTHON}" ]]; then
	echo "Backend venv not found. Run: python3 -m venv venv && source venv/bin/activate && pip install -r requirements.txt"
	exit 1
fi

if [[ ! -d "${ROOT_DIR}/frontend/node_modules" ]]; then
	echo "Frontend dependencies not found. Run: cd frontend && npm install"
	exit 1
fi

REQUESTED_BACKEND_PORT="${BACKEND_PORT}"
REQUESTED_FRONTEND_PORT="${FRONTEND_PORT}"
BACKEND_PORT="$(next_available_port "${BACKEND_PORT}")"
FRONTEND_PORT="$(next_available_port "${FRONTEND_PORT}")"

if [[ "${BACKEND_PORT}" != "${REQUESTED_BACKEND_PORT}" ]]; then
	echo "Port ${REQUESTED_BACKEND_PORT} is already in use; using backend port ${BACKEND_PORT}."
fi
if [[ "${FRONTEND_PORT}" != "${REQUESTED_FRONTEND_PORT}" ]]; then
	echo "Port ${REQUESTED_FRONTEND_PORT} is already in use; using frontend port ${FRONTEND_PORT}."
fi

"${ROOT_DIR}/scripts/bootstrap"

if [[ "${DEMO_MODE}" == true ]]; then
	echo "Preparing an optimized frontend for your presentation (no page compilation during the demo)..."
	(
		cd "${ROOT_DIR}/frontend"
		NEXT_DIST_DIR=.next-demo LATENT_API_ORIGIN= \
			NEXT_PUBLIC_API_BASE_URL="http://localhost:${BACKEND_PORT}/api/v1" npm run build
		mkdir -p .next-demo/standalone/public .next-demo/standalone/.next-demo/static
		cp -R public/. .next-demo/standalone/public/
		cp -R .next-demo/static/. .next-demo/standalone/.next-demo/static/
	)
fi

echo "Starting Latent backend:  http://${BACKEND_HOST}:${BACKEND_PORT}"
(
	cd "${ROOT_DIR}"
	RELOAD_ARGS=()
	if [[ "${DEMO_MODE}" == false ]]; then RELOAD_ARGS=(--reload); fi
	CORS_ORIGINS="http://localhost:${FRONTEND_PORT},http://127.0.0.1:${FRONTEND_PORT}" \
		exec "${BACKEND_PYTHON}" -m uvicorn src.api.main:app ${RELOAD_ARGS[@]+"${RELOAD_ARGS[@]}"} --host "${BACKEND_HOST}" --port "${BACKEND_PORT}"
) &
BACKEND_PID=$!

echo "Starting Latent frontend: http://${FRONTEND_HOST}:${FRONTEND_PORT}"
(
	cd "${ROOT_DIR}/frontend"
	if [[ "${DEMO_MODE}" == true ]]; then
		HOSTNAME="${FRONTEND_HOST}" PORT="${FRONTEND_PORT}" exec node .next-demo/standalone/server.js
	fi
	NEXT_PUBLIC_API_BASE_URL="http://localhost:${BACKEND_PORT}/api/v1" \
		npm run dev -- --hostname "${FRONTEND_HOST}" --port "${FRONTEND_PORT}"
) &
FRONTEND_PID=$!

echo
echo "Latent is starting."
echo "Frontend: http://${FRONTEND_HOST}:${FRONTEND_PORT}/login"
echo "Backend:  http://${BACKEND_HOST}:${BACKEND_PORT}/api/v1/health"
echo
echo "Press Ctrl+C to stop both servers."

wait
